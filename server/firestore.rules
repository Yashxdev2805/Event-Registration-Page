rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ═══════════════════════════════════════════════════════════════════
    // ZERO-TRUST BACKEND ACCESS ONLY POLICY
    // Deny all direct client browser SDK reads and writes across all collections.
    // All reads and mutations MUST execute through privileged Firebase Admin SDK.
    // ═══════════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
