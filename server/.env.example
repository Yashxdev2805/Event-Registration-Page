# ============================================================
# E-Cell Backend API — Environment Configuration (.env.example)
# Copy this file to .env and provide your secrets for local/prod execution.
# NEVER commit real .env files with production secrets to GitHub.
# ============================================================

# ── 1. Server Core Configuration ──
PORT=3001
NODE_ENV=development

# Allowed CORS Origins (comma-separated for dev and production domains)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000,https://ecell.uietkuk.ac.in

# ── 2. Firebase Admin SDK & Cloud Firestore ──
# Option A: Path to Service Account JSON or minified JSON string
FIREBASE_SERVICE_ACCOUNT_KEY=
# Option B: Local Firestore Emulator host for offline testing
FIRESTORE_EMULATOR_HOST=localhost:8080
# Google Cloud Storage Bucket for direct PDF uploads
FIREBASE_STORAGE_BUCKET=ecell-pitch-decks-2026.appspot.com

# ── 3. Distributed Ingress & Rate Limiting (Upstash Redis) ──
# (Optional for dev — in-memory sliding window fallback active if absent)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── 4. Anti-Bot Attestation (Cloudflare Turnstile / reCAPTCHA v3) ──
CF_TURNSTILE_SECRET_KEY=
RECAPTCHA_SECRET_KEY=

# ── 5. Transactional Email API (Brevo / Sendinblue) ──
BREVO_API_KEY=
SENDER_EMAIL=ecell@uietkuk.ac.in
SENDER_NAME=E-Cell UIET KUK

# ── 6. Google Sheets API v4 Live Audit Ledger ──
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=

# ── 7. Observability & Sentry Error Monitoring (Optional) ──
SENTRY_DSN=
