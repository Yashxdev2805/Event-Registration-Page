# Server Port
PORT=3001
NODE_ENV=development

# Allowed CORS Origins (comma-separated)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# Upstash Redis (Optional for dev — in-memory fallback is active if absent)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile / reCAPTCHA Secret Key
RECAPTCHA_SECRET_KEY=

# Brevo / Sendinblue Transactional Email API Key
BREVO_API_KEY=
SENDER_EMAIL=ecell@uietkuk.ac.in

# Google Cloud / Google Sheets Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
