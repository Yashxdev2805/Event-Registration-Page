# ============================================================
# E-Cell Registration Page — Client Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to the repository.
# ============================================================

# Backend API base URL (no trailing slash)
# Local Dev:    http://localhost:3001
# Production:   https://api.ecell.uietkuk.ac.in
VITE_API_BASE_URL=http://localhost:3001

# Cloudflare Turnstile / Google reCAPTCHA v3 site key (public)
VITE_TURNSTILE_SITE_KEY=
VITE_RECAPTCHA_SITE_KEY=

# Sentry DSN for client-side crash telemetry (optional in dev)
VITE_SENTRY_DSN=
